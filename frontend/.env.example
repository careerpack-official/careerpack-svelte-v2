# Frontend Next.js — Convex backend URL.
# NEXT_PUBLIC_* inlined at `next build` time, so set BEFORE build.
NEXT_PUBLIC_CONVEX_URL=https://your-convex-backend.example.com
# PostHog US project ingestion token; never use a personal/admin API key.
POSTHOG_PROJECT_TOKEN=
# Public, reusable DOKU Multiple Payment Link (Accept Any Amount). Never an API key.
# Empty or invalid disables donations. Rebuild after changing.
NEXT_PUBLIC_DOKU_DONATION_URL=
